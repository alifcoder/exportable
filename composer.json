{
  "name": "alifcoder/export-sdk",
  "description": "Async document export (csv/xlsx/pdf) for Laravel with alifcoder/query-filter",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "illuminate/support": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/queue": "^13.0",
    "illuminate/http": "^13.0",
    "illuminate/validation": "^13.0",
    "illuminate/auth": "^13.0",
    "illuminate/console": "^13.0",
    "alifcoder/query-filter": "^2.0.1",
    "maatwebsite/excel": "^4.0",
    "barryvdh/laravel-dompdf": "^3.1"
  },
  "require-dev": {
    "orchestra/testbench": "^11.0",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": { "psr-4": { "Alif\\Export\\": "src/" } },
  "autoload-dev": { "psr-4": { "Alif\\Export\\Tests\\": "tests/" } },
  "extra": { "laravel": { "providers": ["Alif\\Export\\ExportServiceProvider"] } },
  "config": { "sort-packages": true },
  "minimum-stability": "stable",
  "prefer-stable": true
}
